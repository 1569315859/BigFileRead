        {
            "label": "CMake: clean-all",
            "type": "shell",
            "command": "cmake",
            "args": ["-E", "remove_directory", "${workspaceFolder}/build"],
            "group": "build",
            "problemMatcher": [],
            "detail": "清理所有构建目录"
        },
        {
            "label": "CMake: rebuild-debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "build-debug", "--clean-first"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"],
            "detail": "清理并重新构建 Debug (GUI) 版本",
